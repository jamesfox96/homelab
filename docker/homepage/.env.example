TZ=YOUR_TIMEZONE

# Comma-separated host:port values homepage will answer to (LAN address + public tunnel hostname, if you have one)
HOMEPAGE_ALLOWED_HOSTS=YOUR_HOST_IP:3001,dash.YOUR_DOMAIN
HOST_IP=YOUR_HOST_IP
DATA_ROOT=your/media/dir

RADARR_API_KEY=YOUR_RADARR_API_KEY
SONARR_API_KEY=YOUR_SONARR_API_KEY
BAZARR_API_KEY=YOUR_BAZARR_API_KEY
PROWLARR_API_KEY=YOUR_PROWLARR_API_KEY
QBIT_USER=YOUR_QBITTORRENT_USER
QBIT_PASS=YOUR_QBITTORRENT_PASSWORD
JELLYFIN_API_KEY=YOUR_JELLYFIN_API_KEY
SEERR_API_KEY=YOUR_SEERR_API_KEY
PIHOLE_API_KEY=YOUR_PIHOLE_APP_PASSWORD

# Must match GLUETUN_API_KEY in the mediaserver .env
GLUETUN_API_KEY=YOUR_GLUETUN_API_KEY

# Token needs Account > Cloudflare Tunnel > Read
CLOUDFLARE_ACCOUNT_ID=YOUR_CF_ACCOUNT_ID
CLOUDFLARE_TUNNEL_ID=YOUR_CF_TUNNEL_ID
CLOUDFLARE_API_TOKEN=YOUR_CF_API_TOKEN
~
